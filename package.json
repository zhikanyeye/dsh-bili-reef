{
  "name": "dsh-bili-reef",
  "version": "0.5.0",
  "description": "养鱼 + 喂鱼一体化的 DSH 插件：让 agent 自己按生物钟刷 B 站、看懂视频、写两本日记、把值得的 @ 你；并通过内嵌的 bili-cli 运营层，让 AI 拥有属于自己的 B 站账号（评论/私信/发动态/投稿/数据中心）。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "bilibili",
    "bili-cli",
    "agent",
    "diary",
    "whale"
  ],
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "tools",
    "skills",
    "assets",
    "docs",
    "cordis.patch.yml",
    "README.md",
    "NOTICE.md",
    "VISION.md",
    "CHANGELOG.md",
    "LICENSE",
    "tests"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "license": "MIT",
  "author": {
    "name": "zhikanyeye",
    "url": "https://github.com/zhikanyeye"
  },
  "contributors": [
